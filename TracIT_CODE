/* Container for checkbox and label */
.tracit-checkbox-container {
  display: flex;
  align-items: center;
  position: relative;
  cursor: pointer;
  user-select: none;
  min-height: 24px;
}

/* Hide default checkbox */
.tracit-checkbox-input {
  position: absolute;
  opacity: 0;
  cursor: pointer;
  height: 0;
  width: 0;
}

/* Custom checkbox */
.tracit-checkbox-checkmark {
  position: relative;
  height: 18px;
  width: 18px;
  border: 2px solid #002677;
  border-radius: 3px;
  background-color: white;
  flex-shrink: 0;
  transition: all 0.2s ease;
}

/* On hover */
.tracit-checkbox-container:hover .tracit-checkbox-checkmark {
  border-color: #001a4d;
  background-color: rgb(217, 246, 250);
}

/* When checked */
.tracit-checkbox-input:checked ~ .tracit-checkbox-checkmark {
  background-color: #002677;
  border-color: #002677;
}

/* Checkmark icon (hidden when not checked) */
.tracit-checkbox-checkmark::after {
  content: '';
  position: absolute;
  display: none;
  left: 5px;
  top: 2px;
  width: 5px;
  height: 9px;
  border: solid white;
  border-width: 0 2px 2px 0;
  transform: rotate(45deg);
}

/* Show checkmark when checked */
.tracit-checkbox-input:checked ~ .tracit-checkbox-checkmark::after {
  display: block;
}

/* Indeterminate state */
.tracit-checkbox-input:indeterminate ~ .tracit-checkbox-checkmark {
  background-color: #002677;
  border-color: #002677;
}

.tracit-checkbox-input:indeterminate ~ .tracit-checkbox-checkmark::after {
  display: block;
  left: 3px;
  top: 6px;
  width: 10px;
  height: 2px;
  border: none;
  background-color: white;
  transform: none;
}

/* Label styling */
.tracit-checkbox-label {
  margin-left: 8px;
  font-size: 14px;
  color: #333;
  cursor: pointer;
  font-weight: 500;
}

/* Required asterisk */
.tracit-checkbox-required {
  color: #dc3545;
  font-weight: 600;
  margin-left: 2px;
}

/* Helper text */
.tracit-checkbox-helper-text {
  font-size: 13px;
  color: #6c757d;
  margin-left: 26px;
  display: block;
}

/* Error message styling */
.tracit-checkbox-error-message {
  font-size: 13px;
  color: #dc3545;
  display: block;
  margin-left: 26px;
  margin-top: 4px;
}

/* Error state */
.tracit-checkbox-has-error .tracit-checkbox-checkmark {
  border-color: #dc3545;
}

.tracit-checkbox-has-error:hover .tracit-checkbox-checkmark {
  border-color: #dc3545;
  background-color: rgba(220, 53, 69, 0.1);
}

.tracit-checkbox-has-error .tracit-checkbox-input:checked ~ .tracit-checkbox-checkmark {
  background-color: #dc3545;
  border-color: #dc3545;
}

/* Disabled state */
.tracit-checkbox-disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.tracit-checkbox-disabled .tracit-checkbox-checkmark {
  background-color: #f5f5f5;
  cursor: not-allowed;
}

.tracit-checkbox-disabled .tracit-checkbox-label {
  cursor: not-allowed;
  color: #999;
}

.tracit-checkbox-disabled:hover .tracit-checkbox-checkmark {
  border-color: #002677;
  background-color: #f5f5f5;
}

/* Focus state for accessibility */
.tracit-checkbox-input:focus ~ .tracit-checkbox-checkmark {
  outline: 2px solid rgba(0, 38, 119, 0.3);
  outline-offset: 2px;
}
