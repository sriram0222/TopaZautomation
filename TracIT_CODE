/* Import design tokens first */

/* ===== LAYER DEFINITION ===== */
@layer reset, tokens, primitives, adapters, overrides;

/* ===== RESET LAYER ===== */
@layer reset {

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  * {
    margin: 0;
    padding: 0;
  }

