/* Left side: Subtitle | Copyright */
.footer-left {
  display: flex;
  align-items: center;
  gap: var(--space-3);
  flex: 1;
  min-width: 0;        /* allow flex item to shrink below intrinsic text width */
  overflow: hidden;
