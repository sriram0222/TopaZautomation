  /* Size-specific icon sizing */
  .tracit-btn--xs .tracit-btn__icon svg,
  .tracit-btn--xs .tracit-btn__icon .MuiSvgIcon-root {
    width: 14px !important;
    height: 14px !important;
    font-size: 14px !important;
  }

  .tracit-btn--sm .tracit-btn__icon svg,
  .tracit-btn--sm .tracit-btn__icon .MuiSvgIcon-root {
    width: 16px !important;
    height: 16px !important;
    font-size: 16px !important;
  }

  .tracit-btn--md .tracit-btn__icon svg,
  .tracit-btn--md .tracit-btn__icon .MuiSvgIcon-root {
    width: 18px !important;
    height: 18px !important;
    font-size: 18px !important;
  }

  .tracit-btn--lg .tracit-btn__icon svg,
  .tracit-btn--lg .tracit-btn__icon .MuiSvgIcon-root {
    width: 20px !important;
    height: 20px !important;
    font-size: 20px !important;
  }

  /* ===== CUSTOM COLOR BUTTON OVERRIDES ===== */
  /* These use CSS variables set via inline styles to override Harmony's colors */
  
  .tracit-btn--has-custom-color {
